// Woffiz data model (PRD section 8). The Better Auth User is the PRD "Account": it owns one puppy.
// Better Auth's provider-link table is named Account here too; do not confuse the two.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
}

enum PlanStatus {
  ACTIVE
  COMPLETED
}

enum LevelState {
  LOCKED
  CURRENT
  COMPLETED
}

enum Topic {
  TOILET
  BITING
  SLEEP
  ALONE
  COMMANDS
}

enum Outcome {
  INDEPENDENT
  WITH_HELP
  STRUGGLING
}

enum AttemptMode {
  CURRENT
  REVIEW
}

// ----- Better Auth (core schema) -----

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(OWNER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  puppy           Puppy?
  idempotencyKeys IdempotencyKey[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ----- Product data -----

model Puppy {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @unique
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String    @default("")
  // Onboarding answers (age band, skills, difficulties, limitations, practice time). Untrusted text.
  profileJson    Json      @default("{}")
  onboardingStep Int       @default(0)
  // Set once onboarding has produced a plan. Completion is idempotent.
  onboardedAt    DateTime?
  revision       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plans    Plan[]
  attempts Attempt[]
  jobs     GenerationJob[]
}

model Plan {
  id             String     @id @default(uuid()) @db.Uuid
  puppyId        String     @db.Uuid
  puppy          Puppy      @relation(fields: [puppyId], references: [id], onDelete: Cascade)
  version        Int        @default(1)
  status         PlanStatus @default(ACTIVE)
  // Where the content came from: "dev-fixture", "fake" (labeled local generator) or "ai:<model id>".
  source         String     @default("dev-fixture")
  // Optimistic counter, bumped by every frontier change. Clients send the value they saw.
  revision       Int        @default(0)
  currentLevelId String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  levels Level[]

  @@unique([puppyId, version])
}

model Level {
  id                String     @id @default(uuid()) @db.Uuid
  planId            String     @db.Uuid
  plan              Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  position          Int
  topic             Topic
  state             LevelState @default(LOCKED)
  contentVersion    Int        @default(1)
  // Stable identity of a generated level and the stableKeys of earlier levels it builds on (validated, Phase 2).
  stableKey         String?
  prerequisitesJson Json       @default("[]")

  exerciseVersions ExerciseVersion[]
  attempts         Attempt[]
  masteryEvent     MasteryEvent?

  @@unique([planId, position])
  @@unique([planId, stableKey])
  @@index([planId, state])
}

model ExerciseVersion {
  id               String      @id @default(uuid()) @db.Uuid
  levelId          String      @db.Uuid
  level            Level       @relation(fields: [levelId], references: [id], onDelete: Cascade)
  version          Int         @default(1)
  // Hebrew content: title, goal, preparation, steps, successCriterion, stopConditions, easierVariant.
  contentJson      Json
  criterionVersion Int         @default(1)
  // Phase 2: only ids of the isolated test catalog (MediaAsset). Reviewed media arrives in Phase 3.
  mediaId          String?
  media            MediaAsset? @relation(fields: [mediaId], references: [id])
  createdAt        DateTime    @default(now())

  attempts Attempt[]

  @@unique([levelId, version])
}

model Attempt {
  id                String          @id @default(uuid()) @db.Uuid
  puppyId           String          @db.Uuid
  puppy             Puppy           @relation(fields: [puppyId], references: [id], onDelete: Cascade)
  levelId           String          @db.Uuid
  level             Level           @relation(fields: [levelId], references: [id], onDelete: Cascade)
  exerciseVersionId String          @db.Uuid
  exerciseVersion   ExerciseVersion @relation(fields: [exerciseVersionId], references: [id])
  outcome           Outcome
  mode              AttemptMode
  createdAt         DateTime        @default(now())

  masteryEvent MasteryEvent?

  @@index([puppyId, createdAt(sort: Desc)])
  @@index([levelId])
}

model MasteryEvent {
  id               String   @id @default(uuid()) @db.Uuid
  // Unique: at most one completion per level, so a level can never unlock twice.
  levelId          String   @unique @db.Uuid
  level            Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  attemptId        String   @unique @db.Uuid
  attempt          Attempt  @relation(fields: [attemptId], references: [id])
  criterionVersion Int
  confirmedAt      DateTime @default(now())
}

// A key is scoped to (user, operation) and bound to a hash of the request payload.
// The saved response is written in the same transaction as the mutation it describes.
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation    String
  key          String
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([userId, operation, key])
}

// ----- Email abuse limits -----

// Fixed-window counters for the endpoints that send authentication email, shared by every server
// instance. `key` is a SHA-256 hash of the scope and the address or IP: no address or IP is stored.
// Updated only by one atomic INSERT … ON CONFLICT statement (src/server/email/rate-limit.ts).
model EmailRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

// ----- Phase 2: AI generation -----

enum GenerationKind {
  INITIAL_PLAN
  ADAPT_CURRENT
  REVISE_FUTURE
}

enum GenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REJECTED
  STALE
}

// Private operational record of one generation. The payload (candidate output) is purged after 30 days.
model GenerationJob {
  id               String           @id @default(uuid()) @db.Uuid
  puppyId          String           @db.Uuid
  puppy            Puppy            @relation(fields: [puppyId], references: [id], onDelete: Cascade)
  kind             GenerationKind
  status           GenerationStatus @default(PENDING)
  // Puppy.revision (initial plan) or Plan.revision (adapt / revise) seen when the job started.
  expectedRevision Int
  promptVersion    String
  policyVersion    String
  model            String
  attempts         Int              @default(0)
  inputTokens      Int?
  outputTokens     Int?
  latencyMs        Int?
  errorCode        String?
  payloadJson      Json?
  createdAt        DateTime         @default(now())
  finishedAt       DateTime?
  // Owner of the request (copied from the puppy, so a refund needs no join) and the client's Idempotency-Key.
  ownerId          String
  idempotencyKey   String
  // Fencing token and lease. A worker owns the job only while it holds the current generation and the lease has
  // not expired; reclaiming an expired job increments the generation, so a late worker can never commit.
  generation       Int              @default(1)
  leaseExpiresAt   DateTime
  // UTC day whose request counter this job was charged to, and when that unit was given back (at most once).
  quotaChargedDay  DateTime?        @db.Date
  quotaRefundedAt  DateTime?

  @@index([puppyId, createdAt])
  @@index([ownerId, idempotencyKey])
}

// Daily generation counters per account and for the whole system (SHA-256 key, no personal data).
model AiUsageDay {
  key   String   @id
  day   DateTime @db.Date
  count Int

  @@index([day])
}

// Isolated development media catalog. Real, reviewed media is Phase 3.
model MediaAsset {
  id            String   @id
  family        String
  variant       String
  status        String   @default("TEST")
  isTestFixture Boolean  @default(true)
  createdAt     DateTime @default(now())

  exerciseVersions ExerciseVersion[]
}
