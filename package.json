{
  "name": "puppy-training",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "db:dev": "prisma dev --name woffiz --detach --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:stop": "prisma dev stop woffiz",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "node scripts/test-integration.mjs",
    "db:test:dev": "prisma dev --name woffiz-test --detach --port 51223 --db-port 51224 --shadow-db-port 51225",
    "db:test:stop": "prisma dev stop woffiz-test",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "ai:ping": "tsx scripts/ai-ping.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource/heebo": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "mp4-muxer": "5.2.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
