# Copy to .env for local development. Never commit real values.

# Local Prisma dev server (PGlite). Start it with: npm run db:dev
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
# Used only by "prisma migrate dev" as the migration shadow database.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# BETTER_AUTH_URL is also the base of every link in verification and reset emails, and the only trusted origin.

# ----- Email (server only: never expose to the browser, never commit real values) -----
# Every account must verify its address before it can use the app (existing accounts too).
# Resend is used when ALL of RESEND_API_KEY, EMAIL_FROM, TESTER_EMAIL and BETTER_AUTH_URL are set.
# Test phase: registration and all mail are limited to TESTER_EMAIL, in every environment.
# With onboarding@resend.dev as sender, Resend only delivers to the address of the Resend account,
# so TESTER_EMAIL must be that address.
RESEND_API_KEY=""
EMAIL_FROM="Woffiz <onboarding@resend.dev>"
TESTER_EMAIL=""

# Local alternative without Resend: write messages as JSON files instead of sending them.
# Honored only when APP_ENV=local and BETTER_AUTH_URL is on localhost; it wins over Resend.
# With it, LOCAL_SIGNUP=true opens registration to any address on this machine.
# EMAIL_TRANSPORT="outbox"
# EMAIL_OUTBOX_DIR=".email-outbox"

# Without working email (neither of the above) registration is closed everywhere.
# Leave APP_ENV and LOCAL_SIGNUP unset in every deployed environment.
APP_ENV="local"
LOCAL_SIGNUP="true"

# Local PGlite serves one query at a time: keep the pool at 1. Leave unset for standard PostgreSQL.
DATABASE_POOL_MAX="1"

# Sign-in / sign-up / reset attempts allowed per IP per minute (default 5). Only tests raise it.
# AUTH_RATE_MAX="5"
# Verification-resend and reset-request emails per IP per minute (default 3). Only tests raise it.
# A separate limit of 3 per address per 15 minutes is fixed in code.
# AUTH_EMAIL_RATE_MAX="3"

# Later phases - provider not chosen yet.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL_ID=

# Dedicated database for integration tests (the suite wipes it). Start with: npm run db:test:dev
# Set TEST_DB_KIND=postgres only when it is a standard PostgreSQL server (CI): concurrency tests need it.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51224/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
# TEST_DB_KIND="pglite"
